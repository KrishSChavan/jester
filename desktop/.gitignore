# Speech models are tens of megabytes; scripts/fetch-models.mjs downloads them.
models/
# Jester.app: npm's Electron under his name and icon (scripts/jester-app.mjs makes it).
app.noindex/
# His Location Services module (scripts/build-location.mjs builds it).
native/jester-location/build/
# Rust build output.
native/jester-driver/target/
# The watch's Bluetooth helper (npm run watch), and Xcode's per-user files.
native/jester-watch/build/
xcuserdata/
# What spikes/input-in-electron.mjs saw on this machine.
spikes/*-report.json
# The packaged app and its installers (npm run dist), and the helpers collected for it.
dist/
build/bin/
