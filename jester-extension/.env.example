# Copy to .env and fill in. See the comments in that file for what each one does.
#
# build-zip.ps1 mirrors .env to env.txt, which is what the extension falls back
# to if Chrome refuses to serve the dotfile. Both are gitignored; edit .env.
#
#   CURSOR  true / false — the hand-steered on-page cursor and its pinch click.
#           false hides it from the UI entirely as well as switching it off.
#   AI      API key for the assistant. Blank is fine; Jester will tell you it's
#           missing rather than failing silently later.

CURSOR=true
AI=
