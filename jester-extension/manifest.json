{
  "manifest_version": 3,
  "name": "Jester — Hand Gesture Video Control",
  "version": "0.1.0",
  "description": "Control video playback with hand gestures on YouTube, Netflix, Disney+, Hulu and more. All hand tracking runs on-device via MediaPipe.",
  "minimum_chrome_version": "116",

  "permissions": [
    "offscreen",
    "storage",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.netflix.com/*",
    "*://*.hulu.com/*",
    "*://*.disneyplus.com/*",
    "*://*.hotstar.com/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/gp/video/*",
    "*://*.max.com/*",
    "*://*.hbomax.com/*",
    "*://*.peacocktv.com/*",
    "*://*.paramountplus.com/*",
    "*://*.crunchyroll.com/*",
    "*://*.twitch.tv/*",
    "*://*.vimeo.com/*",
    "*://tv.apple.com/*"
  ],

  "optional_permissions": ["debugger"],

  "optional_host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Jester — hand gesture video control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.netflix.com/*",
        "*://*.hulu.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hotstar.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.peacocktv.com/*",
        "*://*.paramountplus.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.twitch.tv/*",
        "*://*.vimeo.com/*",
        "*://tv.apple.com/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["src/content/page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  }
}
